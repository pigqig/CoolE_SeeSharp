<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "影像工作台") · CoolE_SeeSharp</title>
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="shell">
        <aside class="rail">
            <a class="brand" href="/">
                <img class="brand-logo" src="~/img/logo.png" alt="CoolE_SeeSharp" asp-append-version="true" />
                <span>
                    <strong>CoolE_SeeSharp</strong>
                    <small>人臉 · 車牌 · YOLO</small>
                </span>
            </a>
            <nav>
                <a href="/" class="@(ViewContext.RouteData.Values["page"] as string == "/Index" ? "on" : "")">總覽</a>
                <a href="/Datasets" class="@(ViewContext.RouteData.Values["page"] as string == "/Datasets/Index" || ViewContext.RouteData.Values["page"] as string == "/Datasets/Annotate" ? "on" : "")">資料集與標註</a>
                <a href="/Train" class="@(ViewContext.RouteData.Values["page"] as string == "/Train/Index" ? "on" : "")">訓練工作</a>
                <a href="/Infer" class="@(ViewContext.RouteData.Values["page"] as string == "/Infer/Index" ? "on" : "")">相片／影片／串流</a>
                <a href="/Faces" class="@(ViewContext.RouteData.Values["page"] as string == "/Faces/Index" ? "on" : "")">人臉身份庫</a>
                <a href="/Plates" class="@(ViewContext.RouteData.Values["page"] as string == "/Plates/Index" ? "on" : "")">車牌紀錄</a>
                <a href="/Models" class="@(ViewContext.RouteData.Values["page"] as string == "/Models/Index" ? "on" : "")">模型管理</a>
            </nav>
            <div class="rail-foot">
                <div>© 2026 Joseph_Li · 酷意 AI</div>
                <a href="mailto:pigqig@gmail.com">pigqig@gmail.com</a>
                <a href="http://ourcoolidea.com" target="_blank" rel="noopener">ourcoolidea.com</a>
                <a href="https://github.com/pigqig/CoolE_SeeSharp#商業版" target="_blank" rel="noopener">商業版：現場值班</a>
                <a href="https://github.com/pigqig/CoolE_SeeSharp/blob/main/LICENSE" target="_blank" rel="noopener">授權條款（MIT）</a>
                <a href="https://github.com/pigqig/CoolE-AI-KeyFactor" target="_blank" rel="noopener">其他開源：KeyFactor</a>
            </div>
        </aside>
        <main class="stage">
            <header class="top">
                <div>
                    <h1>@ViewData["Title"]</h1>
                    <p class="lede">@ViewData["Lede"]</p>
                </div>
                <div class="chips" id="statusChips"></div>
            </header>
            @RenderBody()
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
